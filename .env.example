NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

NEXT_PUBLIC_SITE_URL=xxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_NAME=LittleRead

# Extra payment return domains (comma-separated), e.g. staging hosts.
# The production domains littlereads.com.ng and www.littlereads.com.ng are
# already pinned IN CODE (src/lib/checkout-callback.ts) and always win over
# NEXT_PUBLIC_SITE_URL as the callback fallback — this var only EXTENDS the
# trusted list.
# Example: ALLOWED_CALLBACK_HOSTS=staging.littlereads.com.ng
# ALLOWED_CALLBACK_HOSTS=

# Secret protecting the /api/cron/reconcile-pending fulfillment sweep
# (Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`).
# CRON_SECRET=generate-a-long-random-string