# LittleReads environment template.
#
# Copy to .env.local for local development. PLACEHOLDERS AND EXAMPLES ONLY —
# never put real secrets in this file.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_public_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Single app origin used for auth links (verification / password recovery).
# Vercel scopes ONE variable per environment — set:
#   Production:  https://littlereads.com.ng
#   Preview:     https://little-reads.vercel.app
#   Local:       a private local origin (e.g. http://localhost:3000)
# Exactly ONE URL per value; trailing slashes are normalized by the app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=LittleReads

# Paystack callbacks are deliberately pinned to the production origin in
# server code (see src/lib/checkout-callback.ts), so Preview/VERCEL_URL/stale
# environment values cannot change them.

# Secret protecting the /api/cron/reconcile-pending fulfillment sweep
# (Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`).
# CRON_SECRET=generate-a-long-random-string
